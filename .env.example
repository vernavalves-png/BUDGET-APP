# Copy this file to .env for local development, or set these as
# environment variables in your hosting provider (e.g. Render dashboard).

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Dubai
CURRENCY_CODE=AED

# Provided automatically by Render/Heroku-style hosts when you attach a
# Postgres database. Leave unset for local SQLite development.
# DATABASE_URL=postgres://user:password@host:5432/dbname
